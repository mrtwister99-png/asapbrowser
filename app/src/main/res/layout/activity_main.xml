<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <!-- TOP BAR - 6 AdBlock, 7 adresa, 8 VPN - tri oddelene prvky pod status barem -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@android:color/transparent"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 6 - AdBlock ON/OFF - vlevo -->
        <FrameLayout
            android:id="@+id/btnAdBlock"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:background="@drawable/btn_adblock_on"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="AdBlock">

            <ImageView
                android:id="@+id/ivAdBlock"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_shield_check"/>

            <TextView
                android:id="@+id/tvAdBlockState"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="ON"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <!-- 7 - aktualni stranka / adresa - stred -->
        <LinearLayout
            android:id="@+id/urlContainer"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_url_dark"
            android:addStatesFromChildren="true"
            android:paddingHorizontal="12dp">

            <!-- zamek: klepnuti = informace o strance -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:layout_marginStart="-9dp">

                <ImageView
                    android:id="@+id/ivUrlLock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Informace o stránce"
                    android:src="@drawable/ic_lock"/>

                <!-- tecka: na tomhle webu je AdBlock vypnuty (vyjimka) -->
                <View
                    android:id="@+id/vUrlLockDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone"/>
            </FrameLayout>

            <EditText
                android:id="@+id/etTopUrl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:singleLine="true"
                android:paddingHorizontal="8dp"/>

            <!-- sdilet: klepnuti = Sdilet odkaz / QR kod -->
            <ImageView
                android:id="@+id/ivUrlShare"
                android:layout_width="46dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-11dp"
                android:padding="10dp"
                android:alpha="0.85"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Sdílet"
                android:src="@drawable/ic_share_url"/>
        </LinearLayout>

        <!-- 8 - VPN ON/OFF - vpravo -->
        <FrameLayout
            android:id="@+id/btnVpn"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:background="@drawable/btn_circle_dark"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="VPN">

            <ImageView
                android:id="@+id/ivVpn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_wifi"/>

            <TextView
                android:id="@+id/tvVpnState"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="OFF"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"/>
        </FrameLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bocni tlacitka - 3 a 4 - dole napul schovane -->
    <ImageButton
        android:id="@+id/btnSideLeftMain"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/side_button_bg"
        android:src="@android:drawable/ic_media_play"
        android:elevation="8dp"
        android:translationX="-28dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="24dp"/>

    <ImageButton
        android:id="@+id/btnSideRightMain"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/side_button_bg"
        android:src="@android:drawable/ic_menu_info_details"
        android:elevation="8dp"
        android:translationX="28dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"/>

    <!-- Naseptavac pro HORNI pole - pod horni listou (jede dolu), prazdny = nulova vyska -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/suggestionsTopView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="4dp"
        android:elevation="20dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Naseptavac hledani - nad spodni listou, prazdny = nulova vyska -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/suggestionsView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="6dp"
        android:elevation="20dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTTOM BAR - 2 Home, 1 hledani, 5 tri oddelena tlacitka -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@android:color/transparent"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 2 - Home -->
        <!-- Domu: klik = domovska stranka, drzeni = nastaveni (zelena ikona se odkryva zespoda nahoru) -->
        <FrameLayout
            android:id="@+id/btnHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_circle_dark"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Domu">

            <ImageView
                android:id="@+id/ivHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_home"/>

            <ImageView
                android:id="@+id/ivHomeGreen"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_home_filled"
                android:tint="#00B055"
                android:visibility="invisible"/>
        </FrameLayout>

        <!-- 1 - Hlavni vyhledavani - bile; vlevo vedle lupy krok zpet, vpravo krok vpred -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp">

            <EditText
                android:id="@+id/etSearchMain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_search_white"
                android:hint="Hledat"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:paddingStart="10dp"
                android:paddingEnd="42dp"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="34dp"
                android:singleLine="true"
                android:textSize="15sp"/>

            <FrameLayout
                android:id="@+id/btnNavBack"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="34dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Zpět">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_back"/>
                <ImageView
                    android:id="@+id/ivNavBackFill"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_back_filled"
                    android:visibility="invisible"/>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnNavForward"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Vpřed">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:scaleX="-1"
                    android:src="@drawable/ic_nav_back"/>
                <ImageView
                    android:id="@+id/ivNavForwardFill"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:scaleX="-1"
                    android:src="@drawable/ic_nav_back_filled"
                    android:visibility="invisible"/>
            </FrameLayout>
        </FrameLayout>

        <!-- 5 - tri oddelena tlacitka: nova zalozka, zalozky, nastaveni -->
        <!-- Karty: ctverecek s poctem otevrenych karet (klik = prehled, drzeni = nova karta) -->
        <FrameLayout
            android:id="@+id/btnTabs"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_circle_dark"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Karty">

            <TextView
                android:id="@+id/tvTabCount"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <!-- Oblibene: klik = Zalozky, drzeni = ulozit stranku (ikona zezelena a zvetsi se) -->
        <FrameLayout
            android:id="@+id/btnBookmarks"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_circle_dark"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Zalozky">

            <ImageView
                android:id="@+id/ivBookmarks"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bookmark"/>
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_search_white"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/asap_logo"
            android:contentDescription="Nastaveni"/>
    </LinearLayout>

    <!-- Plocha gest (pruhledna) pres celou obrazovku, skryta dokud se neotevre -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/gestureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="35dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Prehled karet (dlazdice) pres celou obrazovku, skryty dokud se neotevre -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/tabsView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="40dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
